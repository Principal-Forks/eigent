{
  "id": "eigent-intro",
  "title": "Eigent Codebase Tour",
  "description": "A guided walkthrough of Eigent's open-source Cowork desktop application — covering the Electron shell, React frontend, FastAPI backend, and multi-agent system.",
  "version": "1.0.0",
  "steps": [
    {
      "id": "overview",
      "title": "Welcome to Eigent",
      "description": "Eigent is an open-source Cowork desktop app that lets you build, manage, and deploy a custom AI workforce. The codebase has three main layers: an Electron shell, a React/TypeScript frontend, and a FastAPI/Python backend with multi-agent orchestration powered by CAMEL-AI.",
      "colorMode": "fileTypes"
    },
    {
      "id": "electron-shell",
      "title": "Electron Shell",
      "description": "The Electron layer wraps the React app as a native desktop application. The main process handles window management, IPC, auto-updates, and system integration. The preload scripts expose safe APIs to the renderer process.",
      "focusDirectory": "electron",
      "colorMode": "fileTypes",
      "highlightLayers": [
        {
          "id": "electron-main",
          "name": "Main Process",
          "color": "#3b82f6",
          "items": [
            { "path": "electron/main", "type": "directory" }
          ],
          "opacity": 0.7,
          "renderStrategy": "border"
        },
        {
          "id": "electron-preload",
          "name": "Preload Scripts",
          "color": "#f59e0b",
          "items": [
            { "path": "electron/preload", "type": "directory" }
          ],
          "opacity": 0.7,
          "renderStrategy": "border"
        }
      ]
    },
    {
      "id": "frontend-core",
      "title": "Frontend Application",
      "description": "The React frontend lives in src/. Pages define the main views (Home, Agents, Projects, Settings, etc.), components provide reusable UI, and Zustand stores manage state. Routing, API services, and i18n are also organized here.",
      "focusDirectory": "src",
      "colorMode": "fileTypes",
      "highlightLayers": [
        {
          "id": "pages",
